# Ignore everything in the root repository
/*

# Keep .gitignore itself tracked
!.gitignore
!/AGENTS.md
!/.cursor/

# Whitelist MoonCake project and docs folders
!/MoonCake/
!/mooncake/
!/docs/

# Local notes and unused thumbnails that came with the generated product photos
MoonCake/src/main/resources/static/images/products/**/README.txt
MoonCake/src/main/resources/static/images/products/**/manifest.json
MoonCake/src/main/resources/static/images/products/**/gallery-map.json
MoonCake/src/main/resources/static/images/products/**/thumbnails/
MoonCake/src/main/resources/static/images/products/**/*-thumb.webp
MoonCake/uploads/
