# Copy this file to .env and fill in your SQL Server login.
# Never commit the real .env file.

DB_HOST=localhost
DB_PORT=1433
DB_NAME=MoonCakeDB
DB_USERNAME=YOUR_SQL_SERVER_USERNAME
DB_PASSWORD=YOUR_SQL_SERVER_PASSWORD
DB_TRUST_SERVER_CERTIFICATE=true

# Dedicated SQL Server database used only by integration tests.
TEST_DB_HOST=localhost
TEST_DB_PORT=1433
TEST_DB_NAME=MoonCakeTestDB
TEST_DB_USERNAME=YOUR_SQL_SERVER_USERNAME
TEST_DB_PASSWORD=YOUR_SQL_SERVER_PASSWORD
TEST_DB_TRUST_SERVER_CERTIFICATE=true

AUTO_COMPLETE_CHECK_MS=3600000


# VNPay Sandbox: fill your own merchant credentials, never commit .env.
VNPAY_ENABLED=false
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
APP_PUBLIC_URL=http://localhost:8080
# Optional override; otherwise derived from APP_PUBLIC_URL.
VNPAY_RETURN_URL=
# Configure the following URL in VNPay merchant portal; use a public HTTPS tunnel.
# IPN: https://YOUR-PUBLIC-HOST/payments/vnpay/ipn

# Optional auto-cancel timings (defaults: 15 minutes, 900 seconds, check every 60000 ms).
# Shorten only for local testing.
# UNPAID_ORDER_CANCEL_MINUTES=15
# VNPAY_ATTEMPT_SECONDS=900
# AUTO_CANCEL_CHECK_MS=60000

# Forgot-password SMTP (e.g. Gmail: smtp.gmail.com + an App Password). Never commit real values.
# Leave MAIL_HOST empty to only log the reset link (local demo).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@mooncake.local
# Optional (defaults: 30 minutes token lifetime, 60 seconds between requests).
# PASSWORD_RESET_TOKEN_MINUTES=30
# PASSWORD_RESET_RESEND_SECONDS=60
