  <diagram id="rules" name="Business rules &amp; cardinalities">
    <mxGraphModel grid="1" gridSize="20" page="1" pageWidth="2500" pageHeight="1650" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="rule-h0" value="SCOPE — 4 PURCHASE MODES" vertex="1" parent="1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="90" y="70" width="2200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-b0" value="1. MOONCAKE SKU — bánh lẻ trong PRODUCT_VARIANT.&lt;br&gt;2. GIFT_SET SKU — hộp quà đóng sẵn trong PRODUCT_VARIANT; link BOX_CONFIGURATION loại PRESET để lưu hộp và các bánh cố định.&lt;br&gt;3. EMPTY_BOX SKU — mẫu hộp BOX gắn với một PRODUCT_VARIANT bán rỗng.&lt;br&gt;4. CUSTOM BOX — BOX_CONFIGURATION loại CUSTOM gồm BOX và các bánh BOX_CONFIGURATION_ITEM." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;">
          <mxGeometry x="90" y="125" width="2270" height="175" as="geometry" />
        </mxCell>
        <mxCell id="rule-h1" value="CART / ORDER — XOR" vertex="1" parent="1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="90" y="325" width="2200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-b1" value="Mỗi CART_ITEM hoặc ORDER_ITEM chọn CHÍNH XÁC MỘT: SKU thông thường (PRODUCT_VARIANT) hoặc một BOX_CONFIGURATION tùy chọn.&lt;br&gt;Hộp quà đóng sẵn được mua dưới dạng PRODUCT_VARIANT; không tính các thành phần riêng thêm lần nữa.&lt;br&gt;Đơn có thể chứa cùng lúc hộp rỗng, bánh lẻ, hộp cố định, hộp tự chọn." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;">
          <mxGeometry x="90" y="380" width="2270" height="175" as="geometry" />
        </mxCell>
        <mxCell id="rule-h2" value="BOX CONFIGURATION" vertex="1" parent="1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="90" y="580" width="2200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-b2" value="Mỗi BOX_CONFIGURATION chọn đúng một mẫu BOX.&lt;br&gt;Mỗi BOX_CONFIGURATION có &gt;= 1 BOX_CONFIGURATION_ITEM, mỗi item tham chiếu một bánh PRODUCT_VARIANT và số lượng.&lt;br&gt;Tổng số bánh phải bằng sức chứa hộp khi cấu hình được chốt mua; cấu hình không hợp lệ không được checkout.&lt;br&gt;Loại PRESET chỉ được định nghĩa 1 lần cho SKU set; CUSTOM được tạo theo lựa chọn khách." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;">
          <mxGeometry x="90" y="635" width="2270" height="175" as="geometry" />
        </mxCell>
        <mxCell id="rule-h3" value="B2B BULK DISCOUNT" vertex="1" parent="1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="90" y="835" width="2200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-b3" value="BUSINESS là hồ sơ doanh nghiệp tùy chọn của SALES_ORDER; người đặt đơn vẫn là CUSTOMER.&lt;br&gt;WHOLESALE_TIER định nghĩa ngưỡng (ví dụ từ 50, từ 100), tỷ lệ giảm và phạm vi áp dụng được chốt ở Logical ERD.&lt;br&gt;ORDER_ITEM lưu đơn giá tại lúc mua, số lượng bộ/SKU và số tiền chiết khấu thực tế; backend quyết định giá.&lt;br&gt;Chưa yêu cầu quy trình phê duyệt báo giá riêng; nếu thầy yêu cầu báo giá thì mở rộng QUOTATION sau." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;">
          <mxGeometry x="90" y="890" width="2270" height="175" as="geometry" />
        </mxCell>
        <mxCell id="rule-h4" value="CUSTOMER / PAYMENTS / DELIVERY" vertex="1" parent="1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="90" y="1090" width="2200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-b4" value="Ứng dụng v1.2 yêu cầu CUSTOMER liên kết ACCOUNT ACTIVE trước khi mua; khách chưa đăng nhập chỉ xem catalog. CUSTOMER có thể có nhiều đơn và giỏ lịch sử; giới hạn 1 giỏ active thuộc quy tắc Logical.&lt;br&gt;SALES_ORDER lưu snapshot người nhận, số điện thoại và địa chỉ giao hàng (thuộc tính bổ sung ở Logical ERD).&lt;br&gt;PAYMENT có thể có nhiều lần thử; quy tắc đối soát để không ghi nhận thanh toán thành công nhiều lần." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;">
          <mxGeometry x="90" y="1145" width="2270" height="175" as="geometry" />
        </mxCell>
        <mxCell id="rule-h5" value="CONCEPTUAL vs LOGICAL" vertex="1" parent="1" style="text;html=1;fillColor=none;strokeColor=none;fontSize=23;fontFamily=Arial;fontStyle=1;align=left;verticalAlign=middle;">
          <mxGeometry x="90" y="1345" width="2200" height="48" as="geometry" />
        </mxCell>
        <mxCell id="rule-b5" value="Sơ đồ chính là Conceptual: không thêm PK/FK và data types.&lt;br&gt;Khi chuyển Logical, cụ thể hóa PRODUCT_VARIANT subtype, XOR constraints, trạng thái PRESET/CUSTOM, định mức hợp lệ, giá lịch sử, tỷ lệ chiết khấu, các khóa ngoại và quy tắc duy nhất.&lt;br&gt;Sơ đồ là mô hình đề xuất đã mở rộng so với ảnh nháp, chưa phải mô hình database đã được kiểm chứng bởi runtime." vertex="1" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f7f7f7;strokeColor=#cccccc;fontSize=18;fontFamily=Arial;align=left;verticalAlign=top;spacing=14;">
          <mxGeometry x="90" y="1400" width="2270" height="175" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
