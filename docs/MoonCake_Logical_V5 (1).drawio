        </mxCell>
        <mxCell id="r0" value="1. Eligible discount applies by quantity group to authenticated retail or business orders; BUSINESS is optional profile data, not a discount gate." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1142" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="2. GIFT_BOX includes PRESET SKU and CUSTOM sets counted as boxes; do not count their internal cakes as loose MOONCAKE." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1181" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="3. MOONCAKE group includes only loose mooncakes. EMPTY_BOX never contributes to quantity tiers or discount amount." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1220" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="4. Apply the highest tier independently: GIFT_BOX = 5/20/50/100/200/500 at 5%/8%/10%/12%/15%/18%; MOONCAKE = 50/100 at 5%/10%." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1259" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="5. Discount qualifying lines only and snapshot per-line percentage, unit prices, discounts and payable amounts at checkout." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1298" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="6. COD is permitted for all valid orders, including &gt;=50/100 items; demo shipping is 150k for 50+ gift boxes, else 30k." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1337" width="2880" height="36" as="geometry" />
        </mxCell>
      </root>
