        <mxCell id="n_SALES_ORDER" value="&lt;div style=&quot;font-family:Arial;font-size:17px;font-weight:bold;margin-bottom:8px;border-bottom:1px solid #999;padding-bottom:7px;&quot;&gt;SALES_ORDER&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; order_id&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;UQ&lt;/b&gt; order_code&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;FK&lt;/b&gt; customer_id [nullable]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;FK&lt;/b&gt; business_id [nullable]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;order_type [RETAIL / BUSINESS]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;buyer_name_snapshot&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;buyer_phone_snapshot&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;buyer_email_snapshot [nullable]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;recipient_name&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;recipient_phone&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;shipping_address_snapshot&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;order_note [nullable]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;subtotal_amount&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;discount_amount&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;shipping_fee&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;rounding_adjustment&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;total_amount&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;order_status&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;created_at&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;updated_at&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.35;fontFamily=Arial;fontSize=15;fontColor=#151515;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="2205" y="750" width="485" height="527" as="geometry" />
        </mxCell>
        <mxCell id="e0" value="1 : 0..1" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343434;strokeWidth=1.6;startArrow=ERmandOne;startFill=0;startSize=13;endArrow=ERzeroToOne;endFill=0;endSize=13;exitX=1;exitY=0.49;entryX=0;entryY=0.49;fontFamily=Arial;fontSize=14;fontColor=#272727;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_PRODUCT_VARIANT" target="n_INVENTORY_BALANCE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="1 : 0..N" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343434;strokeWidth=1.6;startArrow=ERmandOne;startFill=0;startSize=13;endArrow=ERzeroToMany;endFill=0;endSize=13;exitX=1;exitY=0.49;entryX=0;entryY=0.45;fontFamily=Arial;fontSize=14;fontColor=#272727;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_INVENTORY_BALANCE" target="n_STOCK_MOVEMENT">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="ADMIN ACTION 0..1" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343434;strokeWidth=1.6;startArrow=ERzeroToMany;startFill=0;startSize=13;endArrow=ERzeroToOne;endFill=0;endSize=13;exitX=1;exitY=0.27;entryX=0;entryY=0.52;fontFamily=Arial;fontSize=14;fontColor=#272727;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_STOCK_MOVEMENT" target="n_ACCOUNT">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2010" y="385" />
              <mxPoint x="2010" y="218" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e3" value="ORDER ACTION 0..1" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343434;strokeWidth=1.6;startArrow=ERzeroToMany;startFill=0;startSize=13;endArrow=ERzeroToOne;endFill=0;endSize=13;exitX=1;exitY=0.84;entryX=0;entryY=0.44;fontFamily=Arial;fontSize=14;fontColor=#272727;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_STOCK_MOVEMENT" target="n_SALES_ORDER">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2095" y="565" />
              <mxPoint x="2095" y="965" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="notes_title" value="INVENTORY RULES / ADMIN SCOPE" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="65" y="1305" width="900" height="28" as="geometry" />
        </mxCell>
        <mxCell id="r0" value="1. One INVENTORY_BALANCE per stocked SKU: MOONCAKE, EMPTY_BOX or ready-packed GIFT_SET. CUSTOM configurations have NO stock of their own." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1353" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="2. available_quantity = still saleable, not necessarily physically absent from warehouse. No reserved_quantity and no reservation table." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1406" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="3. PRESET GIFT_SET purchase subtracts only its packed variant x sets, never the display-only box/cake recipe a second time." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1459" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="4. CUSTOM purchase subtracts EMPTY_BOX x sets plus each selected mooncake SKU x quantity_per_set x sets; aggregate duplicate SKUs." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1512" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r4" value="5. On checkout, atomic stock validation + order creation + SKU deduction. On valid cancellation before SHIPPING, restore ONCE." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1565" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r5" value="6. At SHIPPING or COMPLETED no further stock decrease; no automatic restock after handover. There is no payment deadline/auto-expire." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1618" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="7. Admin may RECEIVE, ADJUST and PACK stock. PACK atomically consumes component stock and increases ready-packed gift-set SKU stock." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1671" width="2640" height="42" as="geometry" />
        </mxCell>
        <mxCell id="r7" value="8. STOCK_MOVEMENT stores signed quantity_delta, order/user and idempotency operation_key. Never let available_quantity go below zero." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="65" y="1724" width="2640" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
