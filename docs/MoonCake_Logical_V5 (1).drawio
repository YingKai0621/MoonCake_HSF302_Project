        <mxCell id="e4" value="optional CUSTOM" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343434;strokeWidth=1.6;startArrow=ERzeroToOne;startFill=0;startSize=13;endArrow=ERzeroToOne;endFill=0;endSize=13;exitX=1;exitY=0.78;entryX=0;entryY=0.45;fontFamily=Arial;fontSize=14;fontColor=#272727;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_CART_ITEM" target="n_BOX_CONFIGURATION">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="2085" y="475" />
              <mxPoint x="2085" y="675" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="notes_title" value="LOGICAL RULES / ASSUMPTIONS" style="text;html=1;strokeColor=none;fillColor=none;fontFamily=Arial;fontStyle=1;fontSize=17;fontColor=#333333;align=left;" vertex="1" parent="1">
          <mxGeometry x="65" y="1040" width="710" height="28" as="geometry" />
        </mxCell>
        <mxCell id="r0" value="1. CART_ITEM XOR and uniqueness: one row per (cart, SKU) or (cart, CUSTOM configuration). Adding the same target increments quantity; no inventory deduction in cart." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1083" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r1" value="2. Checkout atomically claims CART ACTIVE -&gt; CHECKED_OUT, then creates one order and deducts combined stock in the same transaction; repeated/concurrent checkout cannot succeed." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1122" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r2" value="3. Schema retains customer-or-guest ownership for V1 compatibility. Application v1.2 creates and checks out only authenticated CUSTOMER carts; guest_token remains NULL." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1161" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="r3" value="4. CUSTOM BOX_CONFIGURATION belongs to its owning CART; cannot edit another cart's configuration or historical order component snapshots." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;strokeColor=none;fillColor=none;fontFamily=Arial;fontColor=#3d3d3d;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="65" y="1200" width="2880" height="36" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="owns CUSTOM 0..N" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#454545;strokeWidth=1.5;startArrow=ERmandOne;startFill=0;startSize=13;endArrow=ERzeroToMany;endFill=0;endSize=13;exitX=0.58;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="n_CART" target="n_BOX_CONFIGURATION">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1273" y="900" />
              <mxPoint x="2345" y="900" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
