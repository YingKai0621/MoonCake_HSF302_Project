        <mxCell id="e3" value="optional SKU" style="edgeStyle=segmentEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#343434;strokeWidth=1.6;startArrow=ERzeroToMany;startFill=0;startSize=13;endArrow=ERzeroToOne;endFill=0;endSize=13;exitX=1;exitY=0.33;entryX=0;entryY=0.45;fontFamily=Arial;fontSize=14;fontColor=#272727;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="n_CART_ITEM" target="n_PRODUCT_VARIANT">
