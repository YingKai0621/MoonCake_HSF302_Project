        <mxCell id="n_BOX_CONFIGURATION" value="&lt;div style=&quot;font-family:Arial;font-size:17px;font-weight:bold;margin-bottom:8px;border-bottom:1px solid #999;padding-bottom:7px;&quot;&gt;BOX_CONFIGURATION&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;PK&lt;/b&gt; configuration_id&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;FK&lt;/b&gt; box_id&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;FK&lt;/b&gt; cart_id [nullable; CUSTOM owner]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;&lt;b&gt;FK&lt;/b&gt; preset_variant_id [nullable, UQ]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;configuration_type [PRESET / CUSTOM]&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;configuration_status&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;created_at&lt;/div&gt;&lt;div style=&quot;font-family:Arial;font-size:13.5px;line-height:22px;white-space:nowrap;&quot;&gt;updated_at&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F1F1F1;strokeColor=#8A8A8A;strokeWidth=1.35;fontFamily=Arial;fontSize=15;fontColor=#151515;align=left;verticalAlign=top;spacingLeft=10;spacingRight=8;spacingTop=8;overflow=fill;" vertex="1" parent="1">
